# Android build output and signing keys (never commit keys: this repo is public)
android/build/
android/app/assets/
*.jks
*.keystore
*.idsig

# Python caches
__pycache__/
*.pyc

# Copy of the food list published with the web link (source: data/)
dist/data/

# Converted photo cache for the Android build
android/.cache/

# The Android app is shared directly (not via this repo); build it with android/build.sh
dist/*.apk
dist/*.idsig

# Marketplace
marketplace/**/node_modules/
marketplace/backend/data/
marketplace/backend/uploads/*
!marketplace/backend/uploads/.gitkeep
marketplace/backend/.env

